---
/**
 * 全站共用版型:head 的 SEO、公告條、導覽列、頁尾、浮動元件都在這裡維護一份。
 *
 * ⚠ 所有資源路徑一律用 BASE_URL 組出來。GitHub Pages 的網址帶 /YoLab 子路徑,
 *   寫死 '/logo-y.png' 在正式站會 404。
 */
import '../styles/global.css';
import { LINE_URL, GITHUB_URL, FORM_URL, nav, tickerItems, faqs, BASE, withBase } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** 相對於站台根目錄的路徑,例如 'cases/pig-farm'。首頁留空。 */
  path?: string;
  /** 是否輸出 FAQPage 結構化資料(只有首頁需要) */
  faqSchema?: boolean;
}

const {
  title = 'YoLab 軟體開發工作室 | 客製化系統・爬蟲・自動化・企業工具',
  description = 'YoLab 軟體開發工作室 - 台灣一人軟體開發工作室，替中小企業與製造業把重複的人工作業寫成系統。客製化內部系統、流程自動化、爬蟲與資料整合、報表儀表板。程式碼公開在 GitHub。',
  path = '',
  faqSchema = false,
} = Astro.props;

const asset = withBase;
const canonical = new URL(withBase(path), Astro.site).href;
const ogImage = new URL(withBase('og-image.jpg'), Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'YoLab 軟體開發工作室',
  alternateName: 'YoLab',
  url: canonical,
  logo: new URL(asset('logo-y.png'), Astro.site).href,
  image: ogImage,
  description:
    '台灣的一人軟體開發工作室，替中小企業與製造業把重複的人工作業寫成系統。提供客製化內部系統、流程自動化、爬蟲與資料整合、企業報表儀表板、LINE / Discord Bot 開發。程式碼公開在 GitHub，交付附原始碼與文件。',
  areaServed: { '@type': 'Country', name: '台灣' },
  availableLanguage: 'zh-TW',
  sameAs: [GITHUB_URL],
  knowsAbout: [
    '客製化系統開發', '流程自動化', '網頁爬蟲', '資料整合',
    '企業報表儀表板', 'LINE Bot', 'Discord Bot', 'Python', 'FastAPI', '電腦視覺檢測',
  ],
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="系統開發, 客製化系統, Python, 爬蟲, 自動化, 企業系統, YoLab, 軟體開發, LINE Bot, 流程自動化, 報表儀表板"
    />
    <meta name="author" content="YoLab 軟體開發工作室" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/x-icon" href={asset('favicon.ico')} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="64x64" href={asset('favicon-64x64.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0066cc" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />}

    <!-- 主題偏好要在樣式套用前決定,避免深色模式使用者看到閃白。
         這段必須 is:inline:被打包成外部檔案就來不及在首次繪製前執行。 -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('yolab-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>

    <div class="topbar">
      <div class="topbar-marquee" aria-hidden="true">
        <div class="marquee-track marquee-left" data-marquee>
          {[...tickerItems, ...tickerItems].map((t) => (
            <span class="topbar-item"><i class="dot" />{t}</span>
          ))}
        </div>
      </div>
      <a class="topbar-line" href={LINE_URL} target="_blank" rel="noopener">
        <span class="line-badge" aria-hidden="true" />LINE 諮詢
      </a>
    </div>

    <nav class="navbar" id="navbar">
      <div class="container nav-inner">
        <a class="brand" href={BASE} aria-label="YoLab 首頁">
          <img class="brand-mark" src={asset('logo-y.png')} alt="YoLab" width="34" height="34" />
          <img
            class="brand-mark brand-mark-light"
            src={asset('logo-y-white.png')}
            alt="YoLab"
            width="34"
            height="34"
          />
          <span class="brand-text">
            <span class="brand-name">YoLab</span>
            <span class="brand-sub">軟體開發工作室</span>
          </span>
        </a>

        <div class="nav-links" id="navLinks">
          {nav.map((n) => <a href={withBase(n.href)}>{n.label}</a>)}
          <a class="btn btn-primary nav-cta" href={withBase('#contact')}>
            聊聊你的流程
          </a>
        </div>

        <div class="nav-tools">
          <button class="theme-toggle" id="themeToggle" type="button" aria-label="切換深色模式">
            <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.2 4.2l1.5 1.5M18.3 18.3l1.5 1.5M2 12h2M20 12h2M4.2 19.8l1.5-1.5M18.3 5.7l1.5-1.5" /></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" /></svg>
          </button>
          <button
            class="hamburger"
            id="hamburger"
            type="button"
            aria-label="開啟選單"
            aria-expanded="false"
            aria-controls="navLinks"
          >
            <span /><span /><span />
          </button>
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="brand">
            <img
              class="brand-mark brand-mark-light"
              src={asset('logo-y-white.png')}
              alt="YoLab"
              width="32"
              height="32"
            />
            <span class="brand-text">
              <span class="brand-name">YoLab</span>
              <span class="brand-sub">軟體開發工作室</span>
            </span>
          </div>
          <p class="footer-desc">
            替中小企業與製造業把重複的人工作業寫成系統。交付附原始碼與文件，程式碼公開在 GitHub。
          </p>
        </div>
        <div class="footer-col">
          <h4>服務</h4>
          <a href={withBase('#services')}>客製化內部系統</a>
          <a href={withBase('#services')}>流程自動化</a>
          <a href={withBase('#services')}>爬蟲與資料整合</a>
          <a href={withBase('#services')}>報表儀表板</a>
        </div>
        <div class="footer-col">
          <h4>了解 YoLab</h4>
          <a href={withBase('#opensource')}>開源實驗室</a>
          <a href={withBase('#projects')}>專案案例</a>
          <a href={withBase('#process')}>合作流程</a>
          <a href={withBase('#about')}>關於我</a>
        </div>
        <div class="footer-col">
          <h4>聯絡</h4>
          <a href={LINE_URL} target="_blank" rel="noopener">LINE 諮詢</a>
          <a href={FORM_URL} target="_blank" rel="noopener">需求表單</a>
          <a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 YoLab 軟體開發工作室. 保留所有權利。</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener">github.com/Yakitori197 · 21 repos public</a>
      </div>
    </footer>

    <a class="fab-line" href={LINE_URL} target="_blank" rel="noopener" aria-label="用 LINE 諮詢">
      <span class="line-badge line-badge-lg" aria-hidden="true" />
      <span class="fab-text">LINE 諮詢</span>
    </a>
    <button class="to-top" id="toTop" type="button" aria-label="回到頂端">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
    </button>

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
